# YouTube Data API key for public search/video metadata.
# YouTube OAuth can also serve catalog reads when no API key is configured.
YOUTUBE_API_KEY=

# Google OAuth client used to refresh the YouTube user token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:53682/oauth2callback

# User token with YouTube playlist read/write scope. Keep these values secret.
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=

# Optional defaults for YouTube search and auto-created category playlists.
YOUTUBE_REGION=TW
YOUTUBE_PLAYLIST_PREFIX=

# Spotify Developer Dashboard credentials (optional legacy provider)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# User token with playlist scopes for Spotify playlist tools.
SPOTIFY_ACCESS_TOKEN=
SPOTIFY_REFRESH_TOKEN=

# Optional ISO 3166-1 alpha-2 market used for Spotify catalog requests.
SPOTIFY_MARKET=TW
