# YouTube Data API key for public search/video metadata.
# OAuth can also serve catalog reads when no API key is configured.
YOUTUBE_API_KEY=

# Google OAuth client used by npm run youtube:auth and token refresh.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:53682/oauth2callback

# Recommended: local AES-256-GCM encrypted credential store.
# Keep the passphrase in a local secret manager or shell environment.
YOUTUBE_CREDENTIAL_FILE=
YOUTUBE_CREDENTIAL_PASSPHRASE=

# Explicit emergency/local fallback only. Never commit real token values.
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=

# Optional defaults for YouTube search and auto-created category playlists.
YOUTUBE_REGION=TW
YOUTUBE_PLAYLIST_PREFIX=

# Finite provider deadline and read retry budget. Writes are never auto-retried.
PROVIDER_TIMEOUT_MS=15000
PROVIDER_MAX_READ_RETRIES=1

# Spotify Developer Dashboard credentials (optional legacy provider).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_ACCESS_TOKEN=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_MARKET=TW
